<Window x:Class="Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:Contracts.UserControls;assembly=Contracts"
        mc:Ignorable="d"
        Title="PPG Server"
        Height="680" Width="1000"
        Background="#F7F8FA"
        Closing="Window_Closing"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" Color="#000"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#6C63FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5A52E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4840C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LogTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.7*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Status Bar -->
        <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                Style="{StaticResource CardBorder}" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="ServerStatusIndicator"
                             Width="12" Height="12" Fill="#E53E3E"
                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ServerStatusTB"
                               Text="Stopped" FontSize="13" FontWeight="SemiBold"
                               Foreground="#E53E3E" VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Button x:Name="StartServerBTN"
                            Click="StartServerBTN_Click"
                            Content="Start Server"
                            Style="{StaticResource ModernButton}"/>
                </StackPanel>
                <TextBlock Text="PPG Data Server"
                           FontSize="18" FontWeight="Bold" Foreground="#333"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Session Metadata Table -->
        <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource CardBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Session Metadata"
                           Style="{StaticResource SectionHeader}"/>
                <ListView x:Name="MetaDataLV" BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Participant" Width="140"
                                            DisplayMemberBinding="{Binding ParticipantId}"/>
                            <GridViewColumn Header="Device" Width="120"
                                            DisplayMemberBinding="{Binding DeviceId}"/>
                            <GridViewColumn Header="Sample Rate (Hz)" Width="120"
                                            DisplayMemberBinding="{Binding SampleRateHz, StringFormat=F2}"/>
                            <GridViewColumn Header="Offset (ms)" Width="110"
                                            DisplayMemberBinding="{Binding TimeStampOffsetMs}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- Rejected / Events -->
        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Rejected Samples"
                           Style="{StaticResource SectionHeader}"/>
                <TextBox x:Name="RejectedCSVTB" Style="{StaticResource LogTextBox}"
                         Height="100" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                <TextBlock Text="Events Log" Style="{StaticResource SectionHeader}"
                           DockPanel.Dock="Top"/>
                <TextBox x:Name="EventsTB" Style="{StaticResource LogTextBox}"/>
            </DockPanel>
        </Border>

        <!-- Analytics -->
        <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Real-time Analytics" Style="{StaticResource SectionHeader}"/>
                <uc:LabelProgressBar x:Name="HearthRate_PG" ProgressString="HR:" Margin="0,4"/>
                <uc:LabelProgressBar x:Name="IBI_PG" ProgressString="IBI:" Margin="0,4"/>
                <uc:LabelProgressBar x:Name="ANORM_PG" ProgressString="Motion:" Margin="0,4"/>
            </StackPanel>
        </Border>

        <!-- Incoming Rows Counter -->
        <Border Grid.Column="1" Grid.Row="2" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Incoming Data" Style="{StaticResource SectionHeader}"/>
                <TextBox x:Name="IncomingRowsTB" Style="{StaticResource LogTextBox}" Height="60"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
