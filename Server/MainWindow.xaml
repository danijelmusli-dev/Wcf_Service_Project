<Window x:Class="Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Server"
        xmlns:uc="clr-namespace:Contracts.UserControls;assembly=Contracts"
        mc:Ignorable="d"
        Title="ServerWindow" 
        Background ="{DynamicResource ApplicationBackground}"

        Closing="Window_Closing"
        
        Height="620" Width="1050">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.7*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView x:Name="MetaDataLV"
                  Grid.Column="0" Grid.Row="1" 
                  Margin="10"
                  Background="{DynamicResource ApplicationBackground}"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"

                  
                  >
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ParticipantId" Width="110" DisplayMemberBinding="{Binding ParticipantId}" />
                    <GridViewColumn Header="DeviceId" Width="110" DisplayMemberBinding="{Binding DeviceId}"/>
                    <GridViewColumn Header="SampleRateHz" Width="110" DisplayMemberBinding="{Binding SampleRateHz}"/>
                    <GridViewColumn Header="TimestampOffsetMs" Width="110" DisplayMemberBinding="{Binding TimeStampOffsetMs}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Column="1" Grid.Row="1"
                    Orientation="Vertical"
                    Margin="10"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Rejected CSV's"
                           FontSize="20" FontWeight="DemiBold"
                           Margin="5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           />
                <TextBox x:Name="RejectedCSVTB" 
                         Width="250" Height="180" 
                         Margin="5"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Background="{StaticResource TextBoxBackground}"/>
            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="10"
                    HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Events"
                           FontSize="20" FontWeight="DemiBold"
                           Margin="5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="EventsTB" 
                         Width="250" Height="120" 
                         Margin="5"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Background="{StaticResource TextBoxBackground}"
                         />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="2"
                    Orientation="Horizontal">
            <GroupBox Header="Analytics"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Margin="10"
                      Width="400"
                      FontSize="20" FontWeight="DemiBold"
                      VerticalContentAlignment="Center">
                <StackPanel x:Name="E4Panel" Orientation="Vertical"
                            VerticalAlignment="Top" Margin="0 10 0 0">
                    <uc:LabelProgressBar x:Name="HearthRate_PG" Background="{StaticResource TextBoxBackground}" ProgessString="HR: " Margin="5"/>
                    <uc:LabelProgressBar x:Name="IBI_PG"  Background="{StaticResource TextBoxBackground}" ProgessString="IBI: "  Margin="5"/>
                    <uc:LabelProgressBar x:Name="ANORM_PG"  Background="{StaticResource TextBoxBackground}" ProgessString="ANM: "  Margin="5"/>
                </StackPanel>
            </GroupBox>
            <StackPanel>
                <TextBlock 
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Errors"
                           FontSize="20" FontWeight="DemiBold"
                           Margin="5"/>
            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="3"
                    Margin="5">
            <TextBlock                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
Text="Incoming Rows"
                           FontSize="20" FontWeight="DemiBold"
                           Margin="5"/>
            <TextBox 
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Background="{StaticResource TextBoxBackground}"
                x:Name="IncomingRowsTB" 
                     IsReadOnly="True"
                     Margin="5 0 0 0"
                     Height="70"/>

        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="5"
                    HorizontalAlignment="Right">
            <TextBlock x:Name="ServerStatusTB"
                       Text="ServerStatus" 
                       VerticalAlignment="Center"
                       Margin="0 0 5 0"/>
            <Rectangle x:Name="ServerStatusIndicator" 
                       Width="20" Height="20" 
                       Fill="{DynamicResource SystemAccentColorBrush}" 
                       VerticalAlignment="Center" 
                       RadiusX="50" RadiusY="50"
                       Margin="5 0 15 0"/>
            <Button x:Name="StartServerBTN"
                    Click="StartServerBTN_Click"
                    Content="Start"
                    Width="73" Height="37" />
        </StackPanel>

    </Grid>
</Window>
