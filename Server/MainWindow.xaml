<Window x:Class="Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Server"
        xmlns:uc="clr-namespace:Contracts.UserControls;assembly=Contracts"
        mc:Ignorable="d"
        Title="ServerWindow" 
        Background="{StaticResource WindowBackgroundBrush}"
        

        Closing="Window_Closing"
        
        Height="620" Width="1050">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.7*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel  Grid.Column="0" Grid.Row="1" >
            <TextBlock Text="Current Participant:"  HorizontalAlignment="Center" FontSize="30"/>
            <TextBlock x:Name="CurrentPartTxB" Text="Not chosen" Foreground="{StaticResource SystemAccentColorBrush}" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Text="Processed Participants:"  HorizontalAlignment="Center" FontSize="30"/>
            <ListView x:Name="MetaDataLV"
                  Grid.Column="0" Grid.Row="1" 
                  Margin="10,10,10,0"
 Width="608"

                  
                  >
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ParticipantId" Width="150" DisplayMemberBinding="{Binding ParticipantId}" />
                    <GridViewColumn Header="DeviceId" Width="150" DisplayMemberBinding="{Binding DeviceId}"/>
                    <GridViewColumn Header="SampleRateHz" Width="150" DisplayMemberBinding="{Binding SampleRateHz}"/>
                    <GridViewColumn Header="TimestampOffsetMs" Width="150" DisplayMemberBinding="{Binding TimeStampOffsetMs}"/>
                </GridView>
            </ListView.View>
        </ListView>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="1"
                    Orientation="Vertical"
                    Margin="10"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Warnings Log"
                           FontSize="20" FontWeight="DemiBold"
                           Margin="5"
                           />
                <TextBox x:Name="WarningLogTB" 
                         Width="250" Height="175" 
                         Margin="5"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         />
            </StackPanel>

        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2">
            <Border BorderBrush="{StaticResource SystemAccentColorBrush}" BorderThickness="1">
                <StackPanel Width="500" Margin="5">
                    <TextBlock  Text="Valid Values:" FontSize="20" Margin="10,10,10,10"/>
                    <TextBlock  Name="MinHrTb" Text="Minimum Heartrate: " Margin="3" FontSize="18"/>
                    <TextBlock  Name="MaxHrTb" Text="Maximum Heartrate: " Margin="3" FontSize="18"/>
                    <TextBlock Name="MaxMotionTb" Text="Motion Treshold: " Margin="3" FontSize="18"/>
                    <TextBlock Name="ValidIbiTb" Text="Valid IBI Treshold: " Margin="3" FontSize="18"/>

                </StackPanel>
            </Border>
            <Border BorderBrush="{StaticResource SystemAccentColorBrush}" BorderThickness="1">
                <StackPanel Width="500" Margin="5" >
               
                    <TextBlock Text="Current Values:" FontSize="20" Margin="10,10,10,10"/>
                    <TextBlock Name="CurrHr" Text="Heartrate: " Margin="3" FontSize="18"/>
                    <TextBlock Name="CurrMotion" Text="Motion: " Margin="3" FontSize="18"/>
                    <TextBlock Name="CurrIbi" Text="IBI: " Margin="3" FontSize="18"/>
            </StackPanel>
            </Border>

        </StackPanel>
        
        


        <StackPanel Grid.Column="0" Grid.Row="3"
                    Margin="5">
            <TextBlock                             
Text="Incoming Rows"
                           FontSize="20" FontWeight="DemiBold"
                           Margin="5"/>
            <TextBox 
                x:Name="IncomingRowsTB" 
                     IsReadOnly="True"
                     Margin="5 0 0 0"
                     Height="70"/>

        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="5"
                    HorizontalAlignment="Right">
            <TextBlock x:Name="ServerStatusTB"
                       Text="ServerStatus" 
                       VerticalAlignment="Center"
                       Margin="0 0 5 0"/>
            <Rectangle x:Name="ServerStatusIndicator" 
                       Width="20" Height="20" 
                       Fill="Red" 
                       VerticalAlignment="Center" 
                       RadiusX="50" RadiusY="50"
                       Margin="5 0 15 0"/>
            <Button x:Name="StartServerBTN"
                    Click="StartServerBTN_Click"
                    Content="Start"
                    Width="73" Height="37" />
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="3"
             Orientation="Horizontal"
             Margin="0,10,0,0"
             HorizontalAlignment="Center" Width="378">
            <StackPanel Height="117">
                <TextBlock Text="Events"
                    FontSize="20" FontWeight="DemiBold"
                    Margin="5"
                     Width="336"/>
                <TextBox x:Name="EventsTB" 
                  Width="367" Height="65"
                  IsReadOnly="True"
                  TextWrapping="Wrap"
                  FontSize="20"
                  
                  TextChanged="EventsTB_TextChanged"
                  />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
