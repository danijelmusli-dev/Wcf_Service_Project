<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<appSettings>
		<add key="HrMinBpm" value="30" />
		<add key="HrMaxBpm" value="220" />
		<add key="AccMotionThreshold" value="2.5" />
		<add key="IbiOutOfRangePct" value="0.20" />
		<add key="PpgMinSignalThreshold" value="1000" />
		<!-- Absolute path to Data folder. Leave empty to use default (project root/Data). -->
		<add key="DataRootPath" value="" />
	</appSettings>

	<system.serviceModel>

		<bindings>
			<netTcpBinding>
				<binding name="LargeMessageBinding"
						 maxReceivedMessageSize="10485760"
						 maxBufferPoolSize="524288"
						 transferMode="Buffered"
						 receiveTimeout="00:05:00"
						 sendTimeout="00:10:00"
						 openTimeout="00:01:00"
						 closeTimeout="00:00:30">
					<readerQuotas maxDepth="32"
								  maxStringContentLength="1048576"
								  maxArrayLength="65536"
								  maxBytesPerRead="65536"
								  maxNameTableCharCount="65536" />
				</binding>
			</netTcpBinding>
		</bindings>

		<behaviors>
			<serviceBehaviors>
				<behavior name="LargeServiceBehavior">
					<serviceThrottling maxConcurrentCalls="100" maxConcurrentSessions="100" maxConcurrentInstances="100" />
					<serviceDebug includeExceptionDetailInFaults="false" />
				</behavior>
			</serviceBehaviors>
		</behaviors>

		<services>
			<service name="Server.SessionHandlingService"
					 behaviorConfiguration="LargeServiceBehavior">

				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:4005" />
					</baseAddresses>
				</host>

				<endpoint
					  address="SessionHandlingService"
					  binding="netTcpBinding"
					  bindingConfiguration="LargeMessageBinding"
					  contract="Contracts.Services.IPpgService" />

			</service>
		</services>
	</system.serviceModel>



</configuration>