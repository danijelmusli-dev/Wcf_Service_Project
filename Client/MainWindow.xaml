<Window x:Class="Wcf_Service_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wcf_Service_Project"
        xmlns:uc="clr-namespace:Contracts.UserControls;assembly=Contracts"
        Background ="{DynamicResource ApplicationBackground}"
        mc:Ignorable="d"
        
        Title="ClientWindow"
        
        Height="720" Width="600"
        Closing="Window_Closing"
        >
    <Border CornerRadius="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Column="0" Grid.Row="1"
                              Margin="10,10,10,10">
                <StackPanel x:Name="DirectoriesSP" 
                            Background="{DynamicResource TextPanelBackground}"
                                Loaded="DirectoriesSP_Loaded"
                                Margin="10 0 0 0">
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2"
                            Margin="10" Orientation="Vertical">

                <TextBlock Text="Rejected Rows"
                           Name="RejectedRowsTxtB"
                               FontSize="15" FontWeight="DemiBold"
                               Foreground="{DynamicResource SystemAccentColorBrush}"
                               Margin="5 10 0 5"
                           />
                <TextBox x:Name="ExceptionsTB" 
                             IsReadOnly="True"
                             Margin="5 0 5 0"
                             Height="100"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Background="{StaticResource TextBoxBackground}"
                             MaxHeight="130"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="2"
                        Margin="10" Orientation="Vertical">
                <TextBlock Text="Session Info"
                           FontSize="20" FontWeight="DemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="5"/>
                <TextBlock x:Name="SessionInfoTB" Text="No session started."
                           
                           Margin="5"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemAccentColorBrush}"

                           />
                <TextBlock x:Name="RowNumInfoTB" Text="Rows Loaded: "
                           Margin="5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"

                           FontSize="14" FontWeight="Normal"/>
                <TextBlock x:Name="LoadingTimeInfoTB" Text="Loading time: "
                           Margin="5"
                           FontSize="14" FontWeight="Normal"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
/>

            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="1" 
                        Grid.ColumnSpan="2"
                        Orientation="Vertical"
                         Height="330">
                <TextBlock Text="Data Info:"
                               FontSize="20" FontWeight="DemiBold"
                               Margin="5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="Loaded Rows: "
                               Margin="5 10 5 5"
                               FontSize="14" FontWeight="Normal"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="LoadedRowsTB" 
                             IsReadOnly="True"
                             Margin="5 0 5 0"
                             Height="130"
                             MaxHeight="130"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             Background="{StaticResource TextBoxBackground}"
/>
                <ProgressBar x:Name="LoadingDirPB"
               Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2"
               Width="auto" Height="10"
               Foreground="LimeGreen"
               Margin="5"/>
                <Button x:Name="StartSessionBTN"
                        Click="StartSessionBTN_Click"
                        Width="150" Height="30"
                        Content="Start Session" 
                        Margin="5"
                        HorizontalAlignment="Center"
                        FontSize="14" FontWeight="DemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        />
            </StackPanel>




        </Grid>
    </Border>
</Window>