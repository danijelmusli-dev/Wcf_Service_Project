<Window x:Class="Wcf_Service_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PPG Client"
        Height="720" Width="640"
        Background="#F7F8FA"
        Closing="Window_Closing"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" Color="#000"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#6C63FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5A52E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4840C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LogTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,12">
            <DockPanel>
                <Button x:Name="StartSessionBTN"
                        Click="StartSessionBTN_Click"
                        Content="Start Session"
                        Style="{StaticResource ModernButton}"
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PPG Data Client"
                               FontSize="18" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock x:Name="SessionInfoTB"
                               Text="Select a dataset to begin"
                               Style="{StaticResource InfoText}" Foreground="#888"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content: Directories + Data Preview -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Dataset Browser -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Datasets"
                               Style="{StaticResource SectionHeader}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DirectoriesSP"
                                    Loaded="DirectoriesSP_Loaded"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Data Preview -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Data Preview"
                               Style="{StaticResource SectionHeader}"/>
                    <TextBox x:Name="LoadedRowsTB" Style="{StaticResource LogTextBox}"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Session Info -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Rows" Style="{StaticResource InfoText}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RowNumInfoTB" Text="—"
                               Style="{StaticResource InfoText}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Load Time" Style="{StaticResource InfoText}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LoadingTimeInfoTB" Text="—"
                               Style="{StaticResource InfoText}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Rejected" Style="{StaticResource InfoText}" FontWeight="SemiBold"/>
                    <TextBox x:Name="ExceptionsTB"
                             Text="—" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#E53E3E" FontSize="13" FontWeight="SemiBold"
                             Padding="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress Bar -->
        <Border Grid.Row="3" Margin="6,0,6,6"
                Background="White" CornerRadius="6" Padding="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" Color="#000"/>
            </Border.Effect>
            <Grid Height="8">
                <Border CornerRadius="4" Background="#E8E8E8"/>
                <Border CornerRadius="4" ClipToBounds="True">
                    <ProgressBar x:Name="LoadingDirPB"
                                 Minimum="0" Maximum="100" Value="0"
                                 Height="8" BorderThickness="0"
                                 Foreground="#6C63FF" Background="Transparent"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
