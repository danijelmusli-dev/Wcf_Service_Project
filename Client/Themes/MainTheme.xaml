
    <ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <!-- COLORS -->

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#252526"/>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2D2D30"/>

        <SolidColorBrush x:Key="BorderBrushDark" Color="#3F3F46"/>

        <SolidColorBrush x:Key="ForegroundBrush" Color="#EAEAEA"/>

        <SolidColorBrush x:Key="SystemAccentColorBrush"
                     Color="#FF5733"/>

        <!-- WINDOW -->

        <Style TargetType="Window">
            <Setter Property="Background"
                Value="{StaticResource WindowBackgroundBrush}"/>
            <Setter Property="Foreground"
                Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontFamily"
                Value="Segoe UI"/>
        </Style>

        <!-- TEXTBLOCK -->

        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                Value="{StaticResource ForegroundBrush}"/>
        </Style>

        <!-- GROUPBOX -->

        <Style TargetType="GroupBox">
            <Setter Property="Foreground"
                Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Margin"
                Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                Background="{StaticResource PanelBackgroundBrush}"
                                Margin="0,12,0,0">

                                <ContentPresenter Margin="10"/>
                            </Border>

                            <TextBlock Text="{TemplateBinding Header}"
                                   Margin="10,0,0,0"
                                   Background="{StaticResource WindowBackgroundBrush}"
                                   Foreground="{StaticResource SystemAccentColorBrush}"
                                   FontWeight="SemiBold"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BUTTON -->

        <Style TargetType="Button">
            <Setter Property="Background"
                Value="{StaticResource SystemAccentColorBrush}"/>
            <Setter Property="Foreground"
                Value="White"/>
            <Setter Property="BorderThickness"
                Value="0"/>
            <Setter Property="Padding"
                Value="10,5"/>
            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="4">

                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">
                                <Setter Property="Opacity"
                                    Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">
                                <Setter Property="Opacity"
                                    Value="0.7"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TEXTBOX -->

        <Style TargetType="TextBox">
            <Setter Property="Background"
                Value="{StaticResource ControlBackgroundBrush}"/>

            <Setter Property="Foreground"
                Value="{StaticResource ForegroundBrush}"/>

            <Setter Property="BorderBrush"
                Value="{StaticResource SystemAccentColorBrush}"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="Padding"
                Value="5"/>
        </Style>

        <!-- LISTVIEW -->

        <Style TargetType="ListView">
            <Setter Property="Background"
                Value="{StaticResource ControlBackgroundBrush}"/>

            <Setter Property="Foreground"
                Value="{StaticResource ForegroundBrush}"/>

            <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrushDark}"/>
        </Style>

        <!-- LISTVIEW ITEM -->

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground"
                Value="{StaticResource ForegroundBrush}"/>

            <Setter Property="Background"
                Value="Transparent"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                     Value="True">
                    <Setter Property="Background"
                        Value="#404040"/>
                </Trigger>

                <Trigger Property="IsMouseOver"
                     Value="True">
                    <Setter Property="Background"
                        Value="#333333"/>
                </Trigger>

            </Style.Triggers>
        </Style>

        <!-- GRIDVIEW HEADER -->

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background"
                Value="{StaticResource PanelBackgroundBrush}"/>

            <Setter Property="Foreground"
                Value="{StaticResource SystemAccentColorBrush}"/>

            <Setter Property="FontWeight"
                Value="SemiBold"/>
        </Style>

<!-- SCROLLBAR -->
    
    <Style TargetType="ScrollBar">
        <Setter Property="Background"
            Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="Width"
            Value="12" />
    </Style>

    <!-- SCROLLBAR THUMB -->
    <Style TargetType="{x:Type Thumb}">
        <Setter Property="Background"
            Value="{StaticResource SystemAccentColorBrush}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
