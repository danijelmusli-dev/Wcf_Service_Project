<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	
	<appSettings>
		<add key="BatchSize" value="500" />
	</appSettings>
	
	<system.serviceModel>

		<bindings>
			<netTcpBinding>
				<binding name="LargeMessageBinding"
                         maxReceivedMessageSize="2147483647"
                         transferMode="Buffered"
						 receiveTimeout="00:00:30"
						 sendTimeout="00:01:00"
						 openTimeout="00:01:00"
						 closeTimeout="00:01:00">
					<readerQuotas maxDepth="32"
                                  maxStringContentLength="2147483647"
                                  maxArrayLength="2147483647"
                                  maxBytesPerRead="2147483647"
                                  maxNameTableCharCount="2147483647" />
				</binding>
			</netTcpBinding>
		</bindings>
		
		<client>
			<endpoint name="SessionHandlingService"
					 address="net.tcp://localhost:4005/SessionHandlingService"
					 binding="netTcpBinding"
					 bindingConfiguration="LargeMessageBinding"
					 contract="Contracts.Services.IPpgService" />
		</client>
	</system.serviceModel>
	
</configuration>