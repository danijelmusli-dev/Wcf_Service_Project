<UserControl x:Class="Contracts.UserControls.DataDirectory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="44" d:DesignWidth="300"
             Cursor="Hand">
    <Border x:Name="RootBorder"
            Background="Transparent"
            CornerRadius="6"
            Margin="2" Padding="10,8"
            BorderThickness="1" BorderBrush="#E0E0E0">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F0F0FF"/>
                        <Setter Property="BorderBrush" Value="#6C63FF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#x1F4C1;"
                       FontFamily="Segoe UI Emoji"
                       FontSize="18"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBlock x:Name="DirectoryName"
                       Text="{Binding DirName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       VerticalAlignment="Center"
                       FontSize="14" FontWeight="Medium"
                       Foreground="#333"/>
        </StackPanel>
    </Border>
</UserControl>
