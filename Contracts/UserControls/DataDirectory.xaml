<UserControl x:Class="Contracts.UserControls.DataDirectory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Contracts.UserControls"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Width="Auto" Height="50">
        <StackPanel Orientation="Horizontal">
            <fa5:SvgAwesome Icon="Regular_Folder" Width="30" Height="30" Margin="0 0 10 0"></fa5:SvgAwesome>
            <TextBlock x:Name="DirectoryName"
                       Text="{Binding DirName, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                       VerticalAlignment="Center"
                       FontSize="15" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</UserControl>
